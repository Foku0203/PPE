generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { WORKER SUPERVISOR STORE_KEEPER EHS ADMIN }
enum Locale { TH EN MY }
enum RequisitionStatus { PENDING_APPROVAL SPECIAL_APPROVAL_REQUIRED APPROVED READY_FOR_PICKUP COMPLETED REJECTED CANCELLED ON_HOLD_STOCK }
enum ApprovalKind { NORMAL SPECIAL_SUPERVISOR SPECIAL_EHS STORE_RELEASE }
enum ApprovalDecision { APPROVED REJECTED }
enum StockEventType { RECEIPT RESERVE ISSUE RETURN ADJUSTMENT DAMAGE }
enum SerialStatus { AVAILABLE RESERVED ISSUED DAMAGED EXPIRED }

model User {
  id             String         @id @default(cuid())
  employeeId     String         @unique
  displayName    String
  department     String?
  locale         Locale         @default(TH)
  active         Boolean        @default(true)
  roles          UserRole[]
  supervisorId   String?
  supervisor     User?          @relation("SupervisorTeam", fields: [supervisorId], references: [id])
  teamMembers    User[]         @relation("SupervisorTeam")
  requests       Requisition[]  @relation("Requester")
  approvals      Approval[]
  issuedEvents   StockEvent[]   @relation("Issuer")
  receivedEvents StockEvent[]   @relation("Receiver")
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model UserRole {
  userId String
  role   Role
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, role])
}

model PpeItem {
  id             String             @id @default(cuid())
  code           String             @unique
  iconKey        String
  unit           String
  quota          Int?
  lifespanDays   Int?
  reorderPoint   Int              @default(0)
  active         Boolean            @default(true)
  translations   PpeTranslation[]
  requestItems   RequisitionItem[]
  stockLots      StockLot[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model PpeTranslation {
  ppeItemId String
  locale    Locale
  name      String
  shortName String?
  ppeItem   PpeItem @relation(fields: [ppeItemId], references: [id], onDelete: Cascade)
  @@id([ppeItemId, locale])
}

model StockLot {
  id             String       @id @default(cuid())
  ppeItemId      String
  lotNumber      String?
  serialNumber   String?      @unique
  quantity       Int          @default(0)
  reservedQty    Int          @default(0)
  expiryAt       DateTime?
  manufacturedAt DateTime?
  inspectedAt    DateTime?
  serialStatus   SerialStatus @default(AVAILABLE)
  ppeItem        PpeItem      @relation(fields: [ppeItemId], references: [id])
  events         StockEvent[]
  @@index([ppeItemId, expiryAt])
  @@index([ppeItemId, serialStatus])
}

model Requisition {
  id                    String              @id @default(cuid())
  requestNo             String              @unique
  requesterId           String
  status                RequisitionStatus   @default(PENDING_APPROVAL)
  specialApprovalNeeded Boolean             @default(false)
  specialReason         String?
  clientRequestId       String
  requester             User                @relation("Requester", fields: [requesterId], references: [id])
  items                 RequisitionItem[]
  approvals             Approval[]
  stockEvents           StockEvent[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  @@unique([requesterId, clientRequestId])
  @@index([requesterId, status])
}

model RequisitionItem {
  id            String       @id @default(cuid())
  requisitionId String
  ppeItemId     String
  size          String?
  quantity      Int
  reason        String
  eligibleAt    DateTime?
  requisition   Requisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  ppeItem       PpeItem      @relation(fields: [ppeItemId], references: [id])
  @@index([ppeItemId, requisitionId])
}

model Approval {
  id            String           @id @default(cuid())
  requisitionId String
  approverId    String
  kind          ApprovalKind
  decision      ApprovalDecision
  reason        String?
  createdAt     DateTime         @default(now())
  requisition   Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver      User             @relation(fields: [approverId], references: [id])
  @@unique([requisitionId, kind])
}

model StockEvent {
  id            String          @id @default(cuid())
  requisitionId String?
  stockLotId    String
  type          StockEventType
  quantity      Int
  issuerId      String?
  receiverId    String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  requisition   Requisition?    @relation(fields: [requisitionId], references: [id])
  stockLot      StockLot        @relation(fields: [stockLotId], references: [id])
  issuer        User?           @relation("Issuer", fields: [issuerId], references: [id])
  receiver      User?           @relation("Receiver", fields: [receiverId], references: [id])
  @@index([stockLotId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  requestId String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([entity, entityId, createdAt])
}
